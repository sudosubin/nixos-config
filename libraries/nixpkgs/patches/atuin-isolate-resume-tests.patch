+#[tokio::test]
+async fn native_machine_uses_injected_processes_for_every_guard() {
+    use atuin_common::harnesstools::pi::Pi;
+    use atuin_common::harnesstools::sync::TableEntry;
+
+    let dir = tempfile::tempdir().unwrap();
+    let env = env::MockEnv::install();
+    env.set("PI_CODING_AGENT_DIR", dir.path().as_os_str());
+    let harness = AnyHarness::Pi(Pi::PI);
+    let base = LocalTip {
+        native_path: dir.path().join("missing.jsonl"),
+        ..fake::local_tip(&[], None)
+    };
+    let options = AppendOptions::default();
+    for (processes, expected) in [
+        (Processes::Table(vec![]), Liveness::NotLive),
+        (
+            Processes::Table(vec![TableEntry {
+                pid: 42,
+                name: "pi".into(),
+                ..TableEntry::default()
+            }]),
+            Liveness::Unknown,
+        ),
+        (Processes::Unavailable, Liveness::Unknown),
+    ] {
+        let machine = ThisMachine { processes };
+        assert_eq!(machine.is_live(harness, "fixture", None).await, expected);
+        let appended = machine.append(harness, "fixture", &base, &[], &options).await.unwrap_err();
+        let replaced = machine
+            .replace(harness, "fixture", &base, &[], &options, dir.path())
+            .await
+            .unwrap_err();
+        if expected == Liveness::NotLive {
+            assert!(matches!(appended, SyncError::Io(_)), "{appended:?}");
+            assert!(
+                matches!(replaced, SyncError::Unsupported("the branch has no rows")),
+                "{replaced:?}"
+            );
+        } else {
+            for error in [appended, replaced] {
+                assert!(matches!(error, SyncError::MaybeLive), "{error:?}");
+            }
+        }
+    }
+}
+
