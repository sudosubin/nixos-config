+use atuin_ai::commands::{Command as AiCommand, ResumeCmd, ThreadsCmd, resume_with_processes};
+use atuin_client::settings::Settings;
+use atuin_common::harnesstools::sync::Processes;
+use clap::Parser;
+
+#[derive(Parser)]
+enum FixtureCommand {
+    Resume(ResumeCmd),
+    #[command(subcommand)]
+    Threads(ThreadsCmd),
+    #[command(subcommand)]
+    Ai(AiCommand),
+}
+
+fn main() -> eyre::Result<()> {
+    let args: Vec<_> = std::env::args_os().collect();
+    let cmd = match FixtureCommand::try_parse_from(&args) {
+        Ok(
+            FixtureCommand::Resume(cmd)
+            | FixtureCommand::Threads(ThreadsCmd::Resume(cmd))
+            | FixtureCommand::Ai(AiCommand::Resume(cmd))
+            | FixtureCommand::Ai(AiCommand::Threads(ThreadsCmd::Resume(cmd))),
+        ) => cmd,
+        _ => {
+            let exe = std::env::current_exe()?.canonicalize()?;
+            let binary = exe.parent().unwrap().parent().unwrap().join("atuin");
+            let mut command = std::process::Command::new(binary);
+            command.args(args.into_iter().skip(1));
+            #[cfg(unix)]
+            {
+                use std::os::unix::process::CommandExt;
+                return Err(command.exec().into());
+            }
+            #[cfg(not(unix))]
+            std::process::exit(command.status()?.code().unwrap_or(1));
+        }
+    };
+    tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()?
+        .block_on(resume_with_processes(cmd, Settings::new()?, Processes::Table(vec![])))
+}
